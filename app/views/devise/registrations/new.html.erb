<% content_for :title, "Create an account — Informed Opinion" %>

<section class="account-page ui-page">
  <div class="container account-container">
    <header class="account-masthead ui-masthead">
      <p class="editorial-kicker">Account</p>
      <h1>Create an account</h1>
      <p><%= site_copy(:registration_intro) %></p>
    </header>

    <div class="account-layout">
      <main class="account-form-panel">
        <p class="account-switch">Already registered? <%= link_to "Sign in", new_user_session_path %></p>
        <%= render "devise/shared/errors", resource: resource %>

        <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "account-form" }) do |f| %>
          <div class="account-field-row">
            <div class="field">
              <%= f.label :first_name %>
              <%= f.text_field :first_name, autofocus: true, autocomplete: "given-name", required: true %>
            </div>
            <div class="field">
              <%= f.label :last_name %>
              <%= f.text_field :last_name, autocomplete: "family-name", required: true %>
            </div>
          </div>
          <div class="field">
            <%= f.label :email %>
            <%= f.email_field :email, autocomplete: "email", required: true %>
          </div>
          <div class="field">
            <%= f.label :password %>
            <%= f.password_field :password, autocomplete: "new-password", required: true, minlength: 8 %>
            <small>At least 8 characters</small>
          </div>
          <div class="field">
            <%= f.label :password_confirmation, "Confirm password" %>
            <%= f.password_field :password_confirmation, autocomplete: "new-password", required: true %>
          </div>
          <div class="account-consents ui-panel">
            <div class="account-consent-choice">
              <%= f.check_box :accept_terms, required: true %>
              <%= f.label :accept_terms do %>
                I have read and agree to the <%= link_to "participation terms", terms_path, target: "_blank", rel: "noopener" %>
                and have read the <%= link_to "privacy notice", privacy_path, target: "_blank", rel: "noopener" %>.
              <% end %>
            </div>
            <div class="account-consent-choice">
              <%= f.check_box :consent_sensitive_data, required: true %>
              <%= f.label :consent_sensitive_data do %>
                <%= site_copy(:consent_text) %>
              <% end %>
            </div>
          </div>
          <%= f.submit "Create account", class: "button button-primary" %>
        <% end %>
      </main>

      <aside class="account-note">
        <p class="editorial-section-label">Participation</p>
        <h2>How the account is used</h2>
        <ul>
          <li>Opinions can be revised at any time</li>
          <li>Knowledge weights change as answers change</li>
          <li>Eligible opinions contribute to the public aggregate</li>
        </ul>
        <p>Your name and individual responses are not displayed publicly.</p>
      </aside>
    </div>
  </div>
</section>
