<% content_for :title, "Sign in — Informed Opinion" %>

<section class="account-page ui-page">
  <div class="container account-container">
    <header class="account-masthead ui-masthead">
      <p class="editorial-kicker">Account</p>
      <h1>Sign in</h1>
      <p><%= site_copy(:sign_in_intro) %></p>
    </header>

    <div class="account-layout">
      <main class="account-form-panel">
        <p class="account-switch">New to <%= current_site.name %>? <%= link_to site_copy(:create_account), new_user_registration_path %></p>

        <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "account-form" }) do |f| %>
          <div class="field">
            <%= f.label :email %>
            <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true %>
          </div>
          <div class="field">
            <div class="label-line">
              <%= f.label :password %>
              <%= link_to "Forgot your password?", new_password_path(resource_name) %>
            </div>
            <%= f.password_field :password, autocomplete: "current-password", required: true %>
          </div>
          <% if devise_mapping.rememberable? %>
            <label class="check-field">
              <%= f.check_box :remember_me %>
              <span>Keep me signed in</span>
            </label>
          <% end %>
          <%= f.submit "Sign in", class: "button button-primary" %>
        <% end %>
      </main>

      <aside class="account-note">
        <p class="editorial-section-label">Your account</p>
        <h2>What is retained</h2>
        <ul>
          <li>Your registered position on each question</li>
          <li>Your latest answer to each fact question</li>
          <li>The resulting knowledge weight of each opinion</li>
        </ul>
        <p>Individual responses are not displayed publicly.</p>
      </aside>
    </div>
  </div>
</section>
