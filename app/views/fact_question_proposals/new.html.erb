<% content_for :title, "Propose a fact question — #{@opinion_question.title}" %>

<section class="editorial-form-page fact-proposal-page ui-page">
  <div class="container form-page-container">
    <%= link_to "← #{@opinion_question.title}", opinion_question_path(@opinion_question), class: "back-link" %>
    <header class="ui-masthead">
      <p class="editorial-kicker">Evidence contribution · <%= @opinion_question.title %></p>
      <h1>Propose a fact question</h1>
      <p>Submit a sourced question with four plausible answers. A moderator may edit it before publication.</p>
    </header>

    <%= form_with model: [@opinion_question, @proposal], class: "editorial-form fact-proposal-form" do |form| %>
      <%= render "devise/shared/errors", resource: @proposal %>

      <div class="field">
        <%= form.label :prompt, "Question" %>
        <%= form.text_area :prompt, rows: 3, required: true %>
      </div>

      <fieldset class="proposal-answer-fields">
        <legend>Answer choices</legend>
        <p>Mark the correct answer. Every choice should be credible enough to require relevant knowledge.</p>
        <% 4.times do |index| %>
          <div class="proposal-answer-row">
            <%= radio_button_tag "fact_question_proposal[correct_option]", index,
              @proposal.correct_option == index,
              required: true,
              aria: { label: "Answer #{index + 1} is correct" } %>
            <%= label_tag "fact_question_proposal_options_#{index}", "Answer #{index + 1}", class: "sr-only" %>
            <%= text_field_tag "fact_question_proposal[options][]",
              @proposal.options&.fetch(index, nil),
              id: "fact_question_proposal_options_#{index}",
              placeholder: "Answer #{index + 1}",
              required: true %>
          </div>
        <% end %>
      </fieldset>

      <div class="field">
        <%= form.label :explanation, "Why is the marked answer correct?" %>
        <%= form.text_area :explanation, rows: 4, required: true %>
      </div>
      <div class="fact-source-fields">
        <div class="field">
          <%= form.label :source_name, "Source name" %>
          <%= form.text_field :source_name, required: true %>
        </div>
        <div class="field">
          <%= form.label :source_url, "Source URL" %>
          <%= form.url_field :source_url, placeholder: "https://…", required: true %>
        </div>
      </div>
      <aside class="fact-proposition-reference">
        <strong>Opinion proposition being assessed</strong>
        <blockquote><%= @opinion_question.statement %></blockquote>
        <p>Judge direction against this precise proposition: whether knowing the fact would tend to support it, counter it, or provide mixed context.</p>
      </aside>
      <div class="fact-assessment-fields">
        <div class="field">
          <%= form.label :importance_weight, "Importance" %>
          <%= form.select :importance_weight,
            FactQuestion::IMPORTANCE_LEVELS.map { |value, label| ["#{label} (#{value} of 3)", value] },
            { prompt: "Choose an importance" }, required: true %>
        </div>
        <div class="field">
          <%= form.label :evidence_direction, "Likely effect on the proposition" %>
          <%= form.select :evidence_direction,
            FactQuestion::VALENCES.map { |value, label| [label, value] },
            { prompt: "Choose a direction" }, required: true %>
        </div>
      </div>
      <div class="field">
        <%= form.label :importance_rationale, "Why does this importance rating fit?" %>
        <%= form.text_area :importance_rationale, rows: 3, required: true %>
      </div>
      <%= form.submit "Send fact question", class: "button button-primary" %>
    <% end %>

    <% if @previous_proposals.any? %>
      <section class="fact-proposal-history">
        <h2>Your earlier proposals for this opinion</h2>
        <% @previous_proposals.each do |proposal| %>
          <article>
            <div><strong><%= proposal.prompt %></strong><span>Submitted <%= proposal.created_at.to_date.to_fs(:long) %></span></div>
            <b><%= proposal.status.humanize %></b>
          </article>
        <% end %>
      </section>
    <% end %>
  </div>
</section>
