<div class="collective-summary collective-summary-primary">
  <div class="collective-heading">
    <span>Result weighted by factual knowledge</span>
    <% if collective.leading_response %>
      <strong><%= collective.leading_response[:label] %></strong>
    <% else %>
      <strong>No informed result yet</strong>
    <% end %>
  </div>
  <div
    class="opinion-dial"
    style="--dial-angle: <%= collective.dial_angle %>deg"
    role="img"
    aria-label="<%= collective.leading_response ? "Weighted result: #{collective.leading_response[:label]}" : "No informed result yet; dial shown at neutral" %>"
  >
    <span class="dial-label dial-label-no">No</span>
    <span class="dial-label dial-label-neutral">Neutral</span>
    <span class="dial-label dial-label-yes">Yes</span>
    <span class="dial-arc" aria-hidden="true"></span>
    <span class="dial-needle" aria-hidden="true"></span>
    <span class="dial-hub" aria-hidden="true"></span>
  </div>
  <div class="collective-bars">
    <% collective.distribution.each do |bucket| %>
      <div class="collective-row" title="<%= bucket[:respondents] %> registered · <%= bucket[:share] %>% of weighted opinion">
        <span><%= bucket[:label] %></span>
        <div class="collective-track"><i style="width: <%= bucket[:share] %>%"></i></div>
        <b><%= number_with_precision(bucket[:share], precision: 1, strip_insignificant_zeros: true) %>%</b>
      </div>
    <% end %>
  </div>
  <small>
    <%= pluralize(collective.respondents, "registered opinion") %>
    · <%= collective.informed_respondents %> carrying weight
  </small>
</div>
