<% content_for :title, "Informed Opinion — knowledge-weighted public opinion" %>

<section class="editorial-home ui-page">
  <div class="container">
    <header class="editorial-masthead ui-masthead">
      <p class="editorial-kicker">Knowledge-weighted public opinion</p>
      <h1>Current informed opinion</h1>
      <p>Public positions on consequential questions, weighted by demonstrated knowledge of the relevant facts.</p>
    </header>

    <%= form_with url: root_path, method: :get, class: "topic-search", role: "search" do |form| %>
      <%= form.hidden_field :category, value: params[:category] if params[:category].present? %>
      <%= form.hidden_field :tag, value: params[:tag] if params[:tag].present? %>
      <div class="catalogue-search-field">
        <%= form.label :q, "Search opinion questions", class: "sr-only" %>
        <%= form.search_field :q,
          value: params[:q],
          placeholder: "Search questions, categories, or tags",
          autocomplete: "off" %>
        <button type="submit" class="catalogue-search-button" aria-label="Search">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="10.5" cy="10.5" r="6.5"></circle>
            <path d="m15.5 15.5 5 5"></path>
          </svg>
        </button>
      </div>
      <div class="catalogue-order-field">
        <%= form.label :sort, "Order by" %>
        <%= form.select :sort,
          options_for_select(@sort_options.map { |value, label| [ label, value ] }, @sort),
          {},
          data: { controller: "autosubmit", action: "change->autosubmit#submit" } %>
      </div>
    <% end %>

    <div class="editorial-layout">
      <main class="question-index">
        <header class="question-index-heading">
          <div>
            <p class="editorial-section-label">
              <%= params[:q].present? || params[:category].present? || params[:tag].present? ? "Search results" : "All questions" %>
            </p>
            <p><%= pluralize(@result_count, "question") %></p>
          </div>
          <% if params[:q].present? || params[:category].present? || params[:tag].present? %>
            <%= link_to "Clear filters", root_path(sort: @sort), class: "editorial-clear" %>
          <% end %>
        </header>

        <div class="editorial-topic-list">
          <% @opinion_questions.each do |question| %>
            <% opinion = @user_opinions&.fetch(question.id, nil) %>
            <% progress = @progress_by_question&.fetch(question, nil) %>
            <% collective = @collective_by_question.fetch(question) %>

            <article class="editorial-topic">
              <div class="editorial-topic-taxonomy">
                <% if question.category %>
                  <%= link_to question.category.name, root_path(category: question.category.slug) %>
                <% end %>
                <% question.tags.first(3).each do |tag| %>
                  <%= link_to tag.name, root_path(tag: tag.slug) %>
                <% end %>
              </div>

              <div class="editorial-topic-body">
                <div>
                  <h2><%= link_to question.title, opinion_question_path(question) %></h2>
                  <p><%= question.statement %></p>
                </div>

                <div class="editorial-result">
                  <p>
                    <span>Informed aggregate</span>
                    <strong><%= collective.result_label %></strong>
                  </p>
                  <div
                    class="editorial-opinion-scale <%= "is-empty" unless collective.weighted_score %>"
                    style="--result-position: <%= collective.indicator_position %>%"
                    role="img"
                    aria-label="<%= collective.weighted_score ? "Aggregate informed opinion: #{collective.score_percentage}, from no at minus 100 through neutral at zero to yes at plus 100" : "No weighted opinion result yet" %>"
                  >
                    <div class="editorial-scale-track">
                      <i class="editorial-scale-midpoint" aria-hidden="true"></i>
                      <% if collective.weighted_score %>
                        <i class="editorial-scale-indicator" aria-hidden="true"></i>
                      <% end %>
                    </div>
                    <div class="editorial-scale-labels" aria-hidden="true">
                      <span>No</span>
                      <span>Neutral</span>
                      <span>Yes</span>
                    </div>
                  </div>
                  <small>
                    <% if collective.weighted_score %>
                      Score <%= "+" if collective.score_percentage.positive? %><%= number_with_precision(collective.score_percentage, precision: 1, strip_insignificant_zeros: true) %>
                      ·
                    <% end %>
                    <%= pluralize(collective.respondents, "participant") %>
                    · <%= collective.informed_respondents %> carrying weight
                  </small>
                </div>
              </div>

              <footer class="editorial-topic-footer">
                <% if opinion %>
                  <p>Your position: <strong><%= opinion.label %></strong> · <%= progress.weight %>% weight</p>
                  <%= link_to "Continue knowledge check", opinion_question_quiz_path(question) %>
                <% else %>
                  <p><%= question.published_fact_questions.length %> sourced fact questions</p>
                  <%= link_to "Examine question", opinion_question_path(question) %>
                <% end %>
              </footer>
            </article>
          <% end %>

          <% if @opinion_questions.empty? %>
            <div class="editorial-empty">
              <h2>No matching questions</h2>
              <p>Try a broader search or clear the category and tag filters.</p>
            </div>
          <% end %>
        </div>

        <% if @total_pages > 1 %>
          <nav class="editorial-pagination" aria-label="Question catalogue pages">
            <% preserved_filters = params.permit(:q, :category, :tag, :sort).to_h %>
            <% if @page > 1 %>
              <%= link_to "Previous", root_path(preserved_filters.merge(page: @page - 1)) %>
            <% else %>
              <span>Previous</span>
            <% end %>
            <b>Page <%= @page %> of <%= @total_pages %></b>
            <% if @page < @total_pages %>
              <%= link_to "Next", root_path(preserved_filters.merge(page: @page + 1)) %>
            <% else %>
              <span>Next</span>
            <% end %>
          </nav>
        <% end %>
      </main>

      <aside class="editorial-sidebar" aria-label="Browse opinion questions">
        <section>
          <h2>Browse by category</h2>
          <ul class="category-list">
            <% @categories.each do |category| %>
              <li>
                <%= link_to root_path(category: category.slug) do %>
                  <span><%= category.name %></span>
                  <b><%= category.live_opinion_questions.length %></b>
                <% end %>
              </li>
            <% end %>
          </ul>
        </section>

        <section>
          <h2>Popular</h2>
          <ol class="ranked-topic-list">
            <% @popular_questions.each do |question| %>
              <li>
                <%= link_to question.title, opinion_question_path(question) %>
                <span><%= pluralize(@discovery.respondents(question), "participant") %></span>
              </li>
            <% end %>
          </ol>
        </section>

        <section>
          <h2>Controversial</h2>
          <% if @controversial_questions.any? %>
            <ol class="ranked-topic-list">
              <% @controversial_questions.each do |question| %>
                <li><%= link_to question.title, opinion_question_path(question) %></li>
              <% end %>
            </ol>
          <% else %>
            <p class="sidebar-note">More participation is needed before disagreement can be ranked.</p>
          <% end %>
        </section>

        <section>
          <h2>Tags</h2>
          <% if @selected_tag %>
            <div class="selected-tag-filter">
              <span>Selected: <strong><%= @selected_tag.name %></strong></span>
              <%= link_to "Clear tag",
                root_path({
                  q: params[:q].presence,
                  category: params[:category].presence,
                  sort: @sort
                }.compact) %>
            </div>
          <% end %>
          <div class="editorial-tag-cloud">
            <% @popular_tags.each do |tag| %>
              <%= link_to tag.name,
                root_path({
                  q: params[:q].presence,
                  category: params[:category].presence,
                  tag: tag.slug,
                  sort: @sort
                }.compact),
                class: ("is-selected" if tag == @selected_tag) %>
            <% end %>
          </div>
        </section>
      </aside>
    </div>
  </div>
</section>
