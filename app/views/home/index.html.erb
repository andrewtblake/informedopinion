<% content_for :title, "Current informed opinion — Informed Opinion" %>

<section class="results-hero">
  <div class="container results-hero-grid">
    <div>
      <p class="eyebrow">Knowledge-weighted public opinion</p>
      <h1>What informed opinion looks like <em>today.</em></h1>
      <p class="hero-lede">These are not ordinary polls. Every person’s view is weighted by the relevant factual knowledge they have demonstrated.</p>
    </div>
  </div>
</section>

<section class="topics-section results-section" id="current-opinion">
  <div class="container">
    <div class="section-heading">
      <div>
        <p class="eyebrow">The public result</p>
        <h2>Current informed opinion</h2>
      </div>
      <p>Each bar is a share of all demonstrated knowledge contributed to that question—not a share of people counted equally.</p>
    </div>

    <div class="topic-grid">
      <% @opinion_questions.each_with_index do |question, index| %>
        <% opinion = @user_opinions&.fetch(question.id, nil) %>
        <% progress = @progress_by_question&.fetch(question, nil) %>
        <% collective = @collective_by_question.fetch(question) %>
        <article class="topic-card topic-<%= question.accent %> <%= "has-opinion" if opinion %>">
          <div class="topic-card-top">
            <span class="topic-number">0<%= index + 1 %></span>
            <%= link_to "Examine →", opinion_question_path(question), class: "topic-examine" %>
          </div>
          <h3 class="topic-headline"><%= question.title %></h3>
          <p class="topic-statement"><%= question.statement %></p>

          <% if opinion %>
            <%= link_to opinion_question_quiz_path(question), class: "collective-summary-link" do %>
              <%= render "collective_summary", collective: collective %>
            <% end %>
          <% else %>
            <%= render "collective_summary", collective: collective %>
          <% end %>

          <% if opinion %>
            <%= link_to "Continue your knowledge check →",
              opinion_question_quiz_path(question),
              class: "card-cta card-cta-primary" %>
            <div class="card-progress">
              <div class="card-progress-label">
                <span>Your view: <%= opinion.label %></span>
                <strong><%= number_with_precision(progress.weight, precision: 1, strip_insignificant_zeros: true) %>% weight</strong>
              </div>
              <div class="meter"><span style="width: <%= progress.weight %>%"></span></div>
            </div>
          <% else %>
            <%= link_to opinion_question_path(question), class: "card-cta" do %>
              Add your informed opinion <span aria-hidden="true">→</span>
            <% end %>
          <% end %>
        </article>
      <% end %>
    </div>
  </div>
</section>

<section class="participate-section" id="participate">
  <div class="container participate-grid">
    <div>
      <p class="eyebrow">Improve the public result</p>
      <h2>Your opinion belongs here—at the weight your knowledge earns it.</h2>
    </div>
    <div class="participate-copy">
      <p>Choose your present view, then answer sourced factual questions one at a time. Each correct latest answer increases that view’s contribution to the public distribution. You can revise your view whenever the evidence moves you.</p>
      <%= link_to(user_signed_in? ? "#current-opinion" : new_user_registration_path, class: "button button-participate") do %>
        <%= user_signed_in? ? "Choose a question" : "Contribute your opinion" %>
        <span aria-hidden="true">→</span>
      <% end %>
    </div>
  </div>
</section>
