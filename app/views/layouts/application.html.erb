<!DOCTYPE html>
<html>
  <head>
    <title><%= site_page_title(content_for(:title)) %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="<%= current_site.name %>">
    <meta name="theme-color" content="<%= current_site.theme_color %>">
    <meta name="description" content="<%= current_site.description %>">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="<%= site_asset_path("icon.svg") %>" type="image/svg+xml">
    <% unless current_site.alternative? %>
      <link rel="icon" href="<%= site_asset_path("favicon.ico") %>" sizes="any">
      <link rel="icon" href="<%= site_asset_path("icon-32.png") %>" type="image/png" sizes="32x32">
      <link rel="apple-touch-icon" href="<%= site_asset_path("icon.png") %>" sizes="512x512">
    <% end %>

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <% if current_site.alternative? %>
      <%= stylesheet_link_tag "what_do_you_think", "data-turbo-track": "reload" %>
    <% end %>
    <%= javascript_importmap_tags %>
  </head>

  <body data-site="<%= current_site.key.to_s.dasherize %>"<% if user_signed_in? && current_user.moderator? %> data-controller="moderation-heartbeat" data-moderation-heartbeat-heartbeat-url-value="<%= moderator_heartbeat_path %>" data-moderation-heartbeat-mark-url-value="<%= moderator_moderation_views_path %>" data-moderation-heartbeat-moderation-url-value="<%= moderator_root_path %>"<% end %>>
    <header class="site-header">
      <div class="container header-inner">
        <%= link_to root_path, class: "brand", aria: { label: "#{current_site.name} home" } do %>
          <span class="brand-mark" aria-hidden="true"><%= current_site.short_mark %></span>
          <span><%= current_site.name %></span>
        <% end %>
        <nav class="site-nav" aria-label="Account">
          <%= link_to site_copy(:nav_help), help_path, class: "nav-link" %>
          <% if user_signed_in? %>
            <span class="nav-greeting">Hello, <%= current_user.first_name %></span>
            <%= link_to site_copy(:nav_opinions), stats_path, class: "nav-link" %>
            <%= link_to site_copy(:nav_proposals), opinion_question_proposals_path, class: "nav-link" %>
            <%= link_to "Account", account_path, class: "nav-link" %>
            <% if current_user.moderator? %>
              <%= link_to moderator_root_path, class: "nav-link moderation-nav-link" do %>
                Moderation
                <span class="moderation-notification-badge" data-moderation-nav-badge hidden></span>
              <% end %>
            <% end %>
            <%= button_to "Sign out", destroy_user_session_path, method: :delete, class: "nav-link nav-button" %>
          <% else %>
            <%= link_to "Sign in", new_user_session_path, class: "nav-link" %>
            <%= link_to site_copy(:create_account), new_user_registration_path, class: "button button-small" %>
          <% end %>
        </nav>
      </div>
    </header>

    <% if notice.present? || alert.present? %>
      <div class="container flash-wrap" aria-live="polite">
        <% if notice.present? %><div class="flash flash-notice"><%= notice %></div><% end %>
        <% if alert.present? %><div class="flash flash-alert"><%= alert %></div><% end %>
      </div>
    <% end %>

    <main><%= yield %></main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <p><span class="brand-mark brand-mark-small"><%= current_site.short_mark %></span> <%= site_copy(:footer_tagline) %></p>
        <p class="footer-links">
          <%= link_to "How it works", help_path %>
          <span>·</span>
          <%= link_to "Methodology", methodology_path %>
          <span>·</span>
          <%= link_to "Privacy", privacy_path %>
          <span>·</span>
          <%= link_to "Terms", terms_path %>
        </p>
      </div>
    </footer>
  </body>
</html>
