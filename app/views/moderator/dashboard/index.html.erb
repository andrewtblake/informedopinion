<% content_for :title, "Moderation — Informed Opinion" %>

<section class="moderation-page ui-page">
  <div class="container">
    <header class="editorial-masthead moderation-masthead ui-masthead">
      <p class="editorial-kicker">Editorial review</p>
      <h1>Moderation</h1>
      <p>Pending reports, proposed opinion questions, and proposed fact questions.</p>
    </header>

    <details class="moderation-section ui-disclosure draft-question-section" id="question-preparation" <%= "open" if @draft_questions.any? %>>
      <summary>
        <h2>Questions being prepared</h2>
        <span><%= @draft_questions.length %> not live</span>
      </summary>
      <% @draft_questions.each do |question| %>
        <article class="moderation-item draft-question-item">
          <div class="draft-question-summary">
            <h3><%= question.title %></h3>
            <p><%= question.statement %></p>
            <p><strong><%= question.published_fact_questions.length %></strong> published fact questions; <%= Rails.configuration.x.fact_question_proposals.minimum_existing_questions %> required before publication is permitted.</p>
            <details class="fact-bank-review">
              <summary>Review fact-question list</summary>
              <ol>
                <% question.published_fact_questions.each do |fact| %>
                  <li>
                    <span><%= glossary_text(fact.prompt) %></span>
                    <small><%= fact.importance_label %> · <%= fact.valence_label %> · <%= link_to fact.source_name, fact.source_url, target: "_blank", rel: "noopener" %></small>
                    <ol class="fact-bank-options" type="A">
                      <% fact.options.each_with_index do |option, index| %>
                        <li class="<%= "correct" if index == fact.correct_option %>">
                          <%= glossary_text(option) %><% if index == fact.correct_option %> <strong>Correct</strong><% end %>
                        </li>
                      <% end %>
                    </ol>
                    <p><%= glossary_text(fact.explanation) %></p>
                  </li>
                <% end %>
              </ol>
              <% if question.published_fact_questions.empty? %><p>No fact questions have been added.</p><% end %>
            </details>
          </div>
          <div class="draft-question-actions">
            <%= link_to "Add fact question",
              new_opinion_question_fact_question_proposal_path(question),
              class: "button moderation-approve" %>
            <% if question.eligible_for_publication? %>
              <%= button_to "Mark as live", moderator_opinion_question_publication_path(question),
                class: "button moderation-approve",
                data: { turbo_confirm: "Publish #{question.title}? Its aggregate and quiz will become public." } %>
            <% else %>
              <button class="button moderation-approve" disabled>Mark as live</button>
            <% end %>
          </div>
        </article>
      <% end %>
      <% if @draft_questions.empty? %><p class="moderation-empty">No opinion questions are awaiting editorial publication.</p><% end %>
    </details>

    <details class="moderation-section ui-disclosure featured-order-section" id="featured-order">
      <summary>
        <h2>Homepage featured order</h2>
        <span><%= @featured_questions.length %> live</span>
      </summary>
      <p class="moderation-guidance">
        The baseline rewards informed participation, measured disagreement and recent publication, while avoiding consecutive questions from one category. Editorial adjustments are deliberately bounded and can be reset.
      </p>
      <ol class="featured-order-list">
        <% @featured_questions.each_with_index do |question, index| %>
          <% metric = @featured_ranker.metric(question) %>
          <li>
            <span class="featured-rank"><%= index + 1 %></span>
            <div class="featured-question-summary">
              <strong><%= question.title %></strong>
              <span><%= question.category&.name || "Uncategorised" %> · <%= metric.informed_respondents %> informed · <%= metric.respondents %> registered</span>
            </div>
            <span class="featured-adjustment">Editorial <%= question.featured_priority.positive? ? "+" : "" %><%= question.featured_priority %></span>
            <div class="featured-order-actions">
              <%= button_to "Demote", moderator_featured_question_path(question), method: :patch,
                params: { adjustment: -1 }, class: "editorial-control", disabled: question.featured_priority <= -10 %>
              <% if question.featured_priority != 0 %>
                <%= button_to "Reset", moderator_featured_question_path(question), method: :patch,
                  params: { adjustment: "reset" }, class: "editorial-control editorial-control-muted" %>
              <% end %>
              <%= button_to "Promote", moderator_featured_question_path(question), method: :patch,
                params: { adjustment: 1 }, class: "editorial-control", disabled: question.featured_priority >= 10 %>
            </div>
          </li>
        <% end %>
      </ol>
    </details>

    <details class="moderation-section ui-disclosure" <%= "open" if @flags.any? %>>
      <summary>
        <h2>Fact-question reports</h2>
        <span><%= @flags.length %> pending</span>
      </summary>
      <% @flags.each do |flag| %>
        <article class="moderation-item">
          <div class="moderation-meta">
            <strong><%= flag.category_label %></strong>
            <span><%= flag.fact_question.opinion_question.title %></span>
          </div>
          <h3><%= flag.fact_question.prompt %></h3>
          <% if flag.details.present? %><p><%= flag.details %></p><% end %>
          <%= form_with model: flag, url: moderator_fact_question_flag_path(flag), method: :patch, class: "moderation-form moderation-editor fact-report-editor" do |form| %>
            <div class="moderation-edit-fields">
              <p class="moderation-form-guidance">Edit the published fact before choosing <strong>Correct and resolve</strong>. Withdrawal retains the fact and its response history for audit but removes it from quizzes and weighting. Dismissal leaves it unchanged.</p>
              <div class="field">
                <%= label_tag "fact_question_prompt_#{flag.id}", "Question" %>
                <%= text_area_tag "fact_question[prompt]", flag.fact_question.prompt,
                  id: "fact_question_prompt_#{flag.id}", rows: 2, required: true %>
              </div>
              <fieldset class="moderation-answer-editor">
                <legend>Answers; select the correct one</legend>
                <% flag.fact_question.options.each_with_index do |option, index| %>
                  <div>
                    <%= radio_button_tag "fact_question[correct_option]", index,
                      flag.fact_question.correct_option == index, required: true,
                      id: "flag_#{flag.id}_correct_option_#{index}",
                      aria: { label: "Answer #{index + 1} is correct" } %>
                    <%= text_field_tag "fact_question[options][]", option,
                      aria: { label: "Answer #{index + 1}" }, required: true %>
                  </div>
                <% end %>
              </fieldset>
              <div class="field">
                <%= label_tag "fact_question_explanation_#{flag.id}", "Explanation" %>
                <%= text_area_tag "fact_question[explanation]", flag.fact_question.explanation,
                  id: "fact_question_explanation_#{flag.id}", rows: 3, required: true %>
              </div>
              <div class="moderation-inline-fields">
                <div class="field">
                  <%= label_tag "fact_question_source_name_#{flag.id}", "Source name" %>
                  <%= text_field_tag "fact_question[source_name]", flag.fact_question.source_name,
                    id: "fact_question_source_name_#{flag.id}", required: true %>
                </div>
                <div class="field">
                  <%= label_tag "fact_question_source_url_#{flag.id}", "Source URL" %>
                  <%= url_field_tag "fact_question[source_url]", flag.fact_question.source_url,
                    id: "fact_question_source_url_#{flag.id}", required: true %>
                </div>
              </div>
              <div class="moderation-inline-fields">
                <div class="field">
                  <%= label_tag "fact_question_importance_#{flag.id}", "Importance" %>
                  <%= select_tag "fact_question[importance_weight]",
                    options_for_select(FactQuestion::IMPORTANCE_LEVELS.map { |value, label| [ label, value ] }, flag.fact_question.importance_weight),
                    id: "fact_question_importance_#{flag.id}" %>
                </div>
                <div class="field">
                  <%= label_tag "fact_question_direction_#{flag.id}", "Likely effect" %>
                  <%= select_tag "fact_question[evidence_direction]",
                    options_for_select(FactQuestion::VALENCES.map { |value, label| [ label, value ] }, flag.fact_question.evidence_direction),
                    id: "fact_question_direction_#{flag.id}" %>
                </div>
              </div>
              <div class="field">
                <%= label_tag "fact_question_rationale_#{flag.id}", "Importance rationale" %>
                <%= text_area_tag "fact_question[importance_rationale]", flag.fact_question.importance_rationale,
                  id: "fact_question_rationale_#{flag.id}", rows: 2, required: true %>
              </div>
              <div class="field">
                <%= form.label :resolution_notes, "Resolution note" %>
                <%= form.text_area :resolution_notes, rows: 2, required: true,
                  placeholder: "Record what was corrected, why it was withdrawn, or why no change is warranted." %>
              </div>
            </div>
            <div class="moderation-actions">
              <%= form.button "Correct and resolve", name: "fact_question_flag[outcome]", value: "corrected", class: "button moderation-approve" %>
              <%= form.button "Withdraw and resolve", name: "fact_question_flag[outcome]", value: "withdrawn", class: "button moderation-withdraw" %>
              <%= form.button "Dismiss — no change", name: "fact_question_flag[outcome]", value: "dismissed", class: "button moderation-decline" %>
            </div>
          <% end %>
        </article>
      <% end %>
      <% if @flags.empty? %><p class="moderation-empty">No fact-question reports are awaiting review.</p><% end %>
    </details>

    <details class="moderation-section ui-disclosure" <%= "open" if @proposals.any? %>>
      <summary>
        <h2>Proposed opinion questions</h2>
        <span><%= @proposals.length %> pending</span>
      </summary>
      <% @proposals.each do |proposal| %>
        <article class="moderation-item">
          <div class="moderation-meta">
            <strong><%= proposal.category.name %></strong>
            <% if proposal.geographic_scope.present? %><span><%= proposal.geographic_scope %></span><% end %>
          </div>
          <h3><%= proposal.title %></h3>
          <blockquote><%= proposal.statement %></blockquote>
          <dl class="proposal-details">
            <div><dt>Tags</dt><dd><%= proposal.tag_names.join(", ") %></dd></div>
            <% if proposal.geographic_scope.present? %><div><dt>Scope</dt><dd><%= proposal.geographic_scope %></dd></div><% end %>
            <div><dt>Rationale</dt><dd><%= proposal.rationale %></dd></div>
          </dl>
          <%= form_with model: proposal, url: moderator_opinion_question_proposal_path(proposal), method: :patch, class: "moderation-form moderation-editor" do |form| %>
            <div class="moderation-edit-fields">
              <div class="field">
                <%= form.label :final_title, "Final title" %>
                <%= form.text_field :final_title, value: proposal.title, required: true %>
              </div>
              <div class="field">
                <%= form.label :final_statement, "Final proposition" %>
                <%= form.text_area :final_statement, value: proposal.statement, rows: 3, required: true %>
              </div>
              <div class="field">
                <%= form.label :review_notes, "Internal review notes" %>
                <%= form.text_area :review_notes, rows: 2 %>
              </div>
            </div>
            <div class="moderation-actions">
              <%= form.button "Approve", name: "opinion_question_proposal[status]", value: "approved", class: "button moderation-approve" %>
              <%= form.button "Decline", name: "opinion_question_proposal[status]", value: "declined", class: "button moderation-decline" %>
            </div>
          <% end %>
        </article>
      <% end %>
      <% if @proposals.empty? %><p class="moderation-empty">No opinion-question proposals are awaiting review.</p><% end %>
    </details>

    <details class="moderation-section ui-disclosure" <%= "open" if @fact_proposals.any? %>>
      <summary>
        <h2>Proposed fact questions</h2>
        <span><%= @fact_proposals.length %> pending</span>
      </summary>
      <% @fact_proposals.each do |proposal| %>
        <article class="moderation-item">
          <div class="moderation-meta">
            <strong><%= proposal.opinion_question.title %></strong>
            <span><%= FactQuestion::IMPORTANCE_LEVELS.fetch(proposal.importance_weight) %></span>
            <span><%= FactQuestion::VALENCES.fetch(proposal.evidence_direction) %></span>
          </div>
          <%= form_with model: proposal, url: moderator_fact_question_proposal_path(proposal), method: :patch, class: "moderation-form moderation-editor fact-moderation-editor" do |form| %>
            <div class="moderation-edit-fields">
              <div class="field">
                <%= form.label :prompt, "Question" %>
                <%= form.text_area :prompt, rows: 2, required: true %>
              </div>
              <fieldset class="moderation-answer-editor">
                <legend>Answers; select the correct one</legend>
                <% proposal.options.each_with_index do |option, index| %>
                  <div>
                    <%= radio_button_tag "fact_question_proposal[correct_option]", index,
                      proposal.correct_option == index, required: true,
                      aria: { label: "Answer #{index + 1} is correct" } %>
                    <%= text_field_tag "fact_question_proposal[options][]", option,
                      aria: { label: "Answer #{index + 1}" }, required: true %>
                  </div>
                <% end %>
              </fieldset>
              <div class="field">
                <%= form.label :explanation %>
                <%= form.text_area :explanation, rows: 3, required: true %>
              </div>
              <div class="moderation-inline-fields">
                <div class="field"><%= form.label :source_name %><%= form.text_field :source_name, required: true %></div>
                <div class="field"><%= form.label :source_url %><%= form.url_field :source_url, required: true %></div>
              </div>
              <div class="moderation-inline-fields">
                <div class="field">
                  <%= form.label :importance_weight, "Importance" %>
                  <%= form.select :importance_weight, FactQuestion::IMPORTANCE_LEVELS.map { |value, label| [label, value] } %>
                </div>
                <div class="field">
                  <%= form.label :evidence_direction, "Likely effect" %>
                  <%= form.select :evidence_direction, FactQuestion::VALENCES.map { |value, label| [label, value] } %>
                </div>
              </div>
              <div class="field">
                <%= form.label :importance_rationale %>
                <%= form.text_area :importance_rationale, rows: 2, required: true %>
              </div>
              <div class="field">
                <%= form.label :review_notes, "Internal review notes" %>
                <%= form.text_area :review_notes, rows: 2 %>
              </div>
            </div>
            <div class="moderation-actions">
              <%= form.button "Edit and approve", name: "fact_question_proposal[status]", value: "approved", class: "button moderation-approve" %>
              <%= form.button "Decline", name: "fact_question_proposal[status]", value: "declined", class: "button moderation-decline" %>
            </div>
          <% end %>
        </article>
      <% end %>
      <% if @fact_proposals.empty? %><p class="moderation-empty">No fact-question proposals are awaiting review.</p><% end %>
    </details>
  </div>
</section>
