<% content_for :title, "Proposals — Informed Opinion" %>

<section class="proposal-page ui-page">
  <div class="container proposal-page-container">
    <%= link_to "← All questions", root_path, class: "back-link" %>
    <header class="proposal-masthead ui-masthead">
      <p class="editorial-kicker"><%= site_copy(:proposals_kicker) %></p>
      <h1><%= site_copy(:proposals_heading) %></h1>
      <p><%= site_copy(:proposals_intro) %></p>
    </header>

    <% unless user_signed_in? %>
      <section class="proposal-sign-in-notice ui-panel" aria-labelledby="proposal-sign-in-title">
        <div>
          <p class="editorial-section-label">Account required to send</p>
          <h2 id="proposal-sign-in-title">See the whole form and draft your proposal now</h2>
          <p>You can complete every field below before signing in. When you continue, this browser will keep your draft while you sign in or create an account.</p>
        </div>
        <div class="proposal-sign-in-actions">
          <%= link_to "Sign in", sign_in_to_propose_path, class: "button button-primary" %>
          <%= link_to site_copy(:create_account), register_to_propose_path, class: "button" %>
        </div>
      </section>
    <% end %>

    <div class="proposal-workspace">
      <div>
        <header class="proposal-section-heading">
          <p class="editorial-section-label">New proposal</p>
          <h2>Propose an opinion question</h2>
          <p>State one contestable proposition clearly enough that a respondent can agree or disagree with it.</p>
        </header>

        <%= form_with model: @proposal, class: "editorial-form proposal-form",
          data: { controller: "proposal-draft", proposal_draft_authenticated_value: user_signed_in?,
            action: "input->proposal-draft#save change->proposal-draft#save turbo:submit-end->proposal-draft#submitted" } do |form| %>
          <%= render "devise/shared/errors", resource: @proposal %>

          <div class="field">
            <%= form.label :title %>
            <%= form.text_field :title, maxlength: 100, placeholder: "A concise subject heading", required: true %>
          </div>
          <div class="field">
            <%= form.label :statement, "Text" %>
            <%= form.text_area :statement,
              rows: 5,
              maxlength: 1_000,
              placeholder: "A single, specific proposition without loaded or double-barrelled wording",
              required: true %>
          </div>
          <div class="field">
            <%= form.label :category_id, "Category" %>
            <%= form.collection_select :category_id, @categories, :id, :name, { prompt: "Choose a category" }, required: true %>
          </div>
          <div class="field">
            <%= form.label :tags_text, "Tags" %>
            <%= form.text_field :tags_text,
              placeholder: "Comma-separated, for example: Housing, England, Planning",
              required: true %>
          </div>
          <div class="field">
            <%= form.label :geographic_scope, "Geographical scope" %>
            <%= form.text_field :geographic_scope, placeholder: "For example: United Kingdom, United States, Global" %>
          </div>
          <div class="field">
            <%= form.label :rationale, "Why should this question be included?" %>
            <%= form.text_area :rationale,
              rows: 5,
              maxlength: 2_000,
              placeholder: "Explain its public importance, genuine controversy, and the factual issues likely to inform opinion.",
              required: true %>
          </div>
          <%= form.submit(user_signed_in? ? "Send proposal" : "Continue to sign in", class: "button button-primary") %>
        <% end %>
      </div>

      <aside class="proposal-guidance">
        <p class="editorial-section-label">Before you submit</p>
        <h2>A suitable question is</h2>
        <ul>
          <li>Genuinely open to disagreement</li>
          <li>Expressed as one specific proposition</li>
          <li>Capable of being informed by factual evidence</li>
          <li>Of recognisable public interest</li>
        </ul>
        <p>Moderators review the proposal itself, without being shown who submitted it.</p>
      </aside>
    </div>

    <% if user_signed_in? %>
      <section class="proposal-history" aria-labelledby="proposal-history-title">
      <header>
        <div>
          <p class="editorial-section-label">Personal record</p>
          <h2 id="proposal-history-title">Your proposals</h2>
        </div>
        <span><%= pluralize(@proposals.length, "proposal") %></span>
      </header>

      <% @proposals.each do |proposal| %>
        <article class="proposal-record">
          <div class="proposal-record-main">
            <div class="proposal-record-meta">
              <span><%= proposal.category.name %></span>
              <% if proposal.geographic_scope.present? %><span><%= proposal.geographic_scope %></span><% end %>
              <time datetime="<%= proposal.created_at.to_date.iso8601 %>">Submitted <%= proposal.created_at.to_date.to_fs(:long) %></time>
            </div>
            <h3><%= proposal.title %></h3>
            <p><%= proposal.statement %></p>
            <% if proposal.edited_on_approval? %>
              <div class="proposal-final-wording">
                <strong>Published wording</strong>
                <h4><%= proposal.final_title %></h4>
                <p><%= proposal.final_statement %></p>
              </div>
            <% end %>
          </div>
          <p class="proposal-status proposal-status-<%= proposal.status %>">
            <span>Status</span>
            <strong><%= proposal.decision_label %></strong>
          </p>
        </article>
      <% end %>

      <% if @proposals.empty? %>
        <p class="proposal-history-empty">You have not submitted an opinion-question proposal.</p>
      <% end %>
      </section>
    <% end %>
  </div>
</section>
