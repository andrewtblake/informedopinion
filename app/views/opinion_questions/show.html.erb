<% content_for :title, "#{@opinion_question.title} — Informed Opinion" %>

<section class="topic-page ui-page">
  <div class="container narrow-container">
    <%= link_to "← All questions", root_path(anchor: "topics"), class: "back-link" %>

    <div class="topic-hero-card ui-sheet ui-sheet-emphasis">
      <p class="eyebrow ui-kicker"><%= @opinion_question.title %></p>
      <h1>Which response best reflects your view?</h1>
      <blockquote><%= @opinion_question.statement %></blockquote>

      <% unless user_signed_in? %>
        <div class="signin-gate">
          <p>Create a free account to register your response and keep your knowledge score.</p>
          <div>
            <%= link_to "Create account", new_user_registration_path, class: "button button-primary" %>
            <%= link_to "I already have an account", new_user_session_path, class: "text-link" %>
          </div>
        </div>
      <% else %>
        <%= form_with model: @user_opinion || UserOpinion.new,
          url: @user_opinion ? opinion_question_user_opinion_path(@opinion_question) : opinion_question_user_opinion_path(@opinion_question),
          method: @user_opinion ? :patch : :post,
          class: "opinion-form" do |form| %>
          <fieldset>
            <legend class="sr-only">Choose your opinion</legend>
            <div class="opinion-options">
              <% @opinion_question.response_options.each_with_index do |option, index| %>
                <label class="opinion-option ui-choice">
                  <%= form.radio_button :position, index, checked: @user_opinion&.position == index, required: true %>
                  <span class="radio-dot"></span>
                  <span><%= option %></span>
                </label>
              <% end %>
            </div>
          </fieldset>
          <div class="opinion-submit ui-action-footer">
            <%= form.submit @user_opinion ? "Revise my opinion" : "Register my opinion", class: "button button-primary" %>
            <% if @user_opinion %>
              <%= link_to "Continue knowledge check →", opinion_question_quiz_path(@opinion_question), class: "text-link" %>
            <% else %>
              <small>Your starting weight will be 0% until you answer facts.</small>
            <% end %>
          </div>
        <% end %>
      <% end %>
    </div>

    <% if @user_opinion %>
      <div class="current-weight ui-panel">
        <div>
          <p class="eyebrow">Your current position</p>
          <h2><%= @user_opinion.label %></h2>
          <p><%= @progress.correct %> correct from <%= @progress.total %> available facts</p>
        </div>
        <div class="weight-ring" style="--weight: <%= @progress.weight %>">
          <strong><%= number_with_precision(@progress.weight, precision: 1, strip_insignificant_zeros: true) %>%</strong>
          <span>weight</span>
        </div>
      </div>
    <% end %>

    <% if user_signed_in? %>
      <section class="topic-reaction-panel ui-panel">
        <div>
          <p class="eyebrow">Question quality</p>
          <h2>Is this a worthwhile opinion question?</h2>
          <% if @reaction %>
            <p>Your response: <strong><%= @reaction.kind.humanize %></strong><%= " — #{@reaction.reason}" if @reaction.reason.present? %></p>
          <% else %>
            <p>Likes help identify useful questions. A dislike requires a reason so moderators receive actionable criticism.</p>
          <% end %>
        </div>
        <div class="reaction-actions">
          <div class="like-control">
            <span>Positive assessment</span>
            <%= button_to "Like",
              opinion_question_reaction_path(@opinion_question),
              method: :post,
              params: { opinion_question_reaction: { kind: "like" } },
              class: "reaction-like ui-button #{'is-active' if @reaction&.like?}" %>
          </div>
          <%= form_with url: opinion_question_reaction_path(@opinion_question), method: :post, class: "dislike-form" do |form| %>
            <%= form.hidden_field :kind, value: "dislike", name: "opinion_question_reaction[kind]" %>
            <%= form.label :reason, "Dislike — reason required" %>
            <%= form.text_area :reason,
              name: "opinion_question_reaction[reason]",
              value: (@reaction.reason if @reaction&.dislike?),
              rows: 2,
              required: true,
              placeholder: "What makes the question unsuitable or poorly framed?" %>
            <%= form.submit "Dislike", class: "reaction-dislike ui-button #{'is-active' if @reaction&.dislike?}" %>
          <% end %>
          <% if @reaction %>
            <%= button_to "Remove response",
              opinion_question_reaction_path(@opinion_question),
              method: :delete,
              class: "reaction-remove" %>
          <% end %>
        </div>
      </section>

      <section class="fact-contribution-panel">
        <div>
          <p class="eyebrow">Contribute evidence</p>
          <h2>Propose a fact question</h2>
          <p><%= @fact_proposal_eligibility.explanation %></p>
        </div>
        <% if @fact_proposal_eligibility.eligible? %>
          <%= link_to "Propose a fact question",
            new_opinion_question_fact_question_proposal_path(@opinion_question),
            class: "button contribution-button" %>
        <% end %>
      </section>
    <% end %>
  </div>
</section>
