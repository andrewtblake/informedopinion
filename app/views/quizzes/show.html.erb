<% content_for :title, "#{@opinion_question.title} knowledge check — Informed Opinion" %>

<section class="quiz-page ui-page">
  <div class="container quiz-container">
    <div class="quiz-header">
      <div>
        <%= link_to "← Leave quiz", root_path(anchor: "topics"), class: "back-link" %>
        <p class="eyebrow"><%= @opinion_question.title %> · knowledge check</p>
      </div>
      <div class="quiz-weight">
        <span>Opinion weight</span>
        <strong><%= number_with_precision(@progress.weight, precision: 1, strip_insignificant_zeros: true) %>%</strong>
      </div>
    </div>

    <div class="quiz-progress" aria-label="<%= @progress.answered %> of <%= @progress.total %> questions answered">
      <div><span style="width: <%= @progress.answered.fdiv(@progress.total) * 100 %>%"></span></div>
      <p><strong><%= @progress.answered %></strong> answered <span>·</span> <strong><%= @progress.correct %></strong> correct <span>·</span> <%= @progress.remaining %> unseen <span>·</span> unweighted score <%= number_with_precision(@progress.raw_weight, precision: 1, strip_insignificant_zeros: true) %>%</p>
    </div>

    <% if @feedback %>
      <article class="quiz-card ui-sheet ui-sheet-emphasis feedback-card <%= @feedback.correct? ? "feedback-correct" : "feedback-incorrect" %>">
        <div class="feedback-status">
          <span class="status-icon" aria-hidden="true"><%= @feedback.correct? ? "✓" : "×" %></span>
          <h1><%= @feedback.correct? ? "Correct" : "Incorrect" %></h1>
        </div>
        <p class="feedback-question"><%= glossary_text(@fact_question.prompt) %></p>
        <aside class="fact-importance">
          <strong>Importance: <%= @fact_question.importance_label %> (<%= @fact_question.importance_weight %> of 3)</strong>
        </aside>
        <% if @feedback.correct? %>
          <div class="answer-comparison answer-comparison-correct">
            <p>
              <span>Your correct answer</span>
              <%= glossary_text(@fact_question.options[@feedback.selected_option]) %>
            </p>
          </div>
        <% else %>
          <div class="answer-comparison">
            <p><span>Your answer</span><%= glossary_text(@fact_question.options[@feedback.selected_option]) %></p>
            <p><span>Correct answer</span><%= glossary_text(@fact_question.correct_answer) %></p>
          </div>
        <% end %>
        <div class="explanation">
          <div class="explanation-panel">
            <h2>Why this is the answer</h2>
            <p><%= glossary_text(@fact_question.explanation) %></p>
          </div>
          <%= link_to @fact_question.source_url, target: "_blank", rel: "noopener", class: "source-link" do %>
            Read the source: <%= @fact_question.source_name %> <span aria-hidden="true">↗</span>
          <% end %>
          <%= link_to "Report this fact question",
            new_fact_question_flag_path(fact_question_id: @fact_question.id),
            class: "fact-report-link" %>
        </div>
        <footer class="quiz-action-footer ui-action-footer">
          <%= link_to opinion_question_quiz_path(@opinion_question), class: "button button-primary button-wide" do %>
            Next question <span aria-hidden="true">→</span>
          <% end %>
        </footer>
      </article>
    <% elsif @fact_question %>
      <article class="quiz-card ui-sheet ui-sheet-emphasis question-card">
        <header class="quiz-question-heading">
          <div class="question-meta">
            <span>Fact question</span>
            <% if @progress.complete? %><span class="retake-badge">Review round</span><% end %>
          </div>
          <h1><%= glossary_text(@fact_question.prompt) %></h1>
          <aside class="fact-importance">
            <strong>Importance: <%= @fact_question.importance_label %> (<%= @fact_question.importance_weight %> of 3)</strong>
          </aside>
        </header>
        <%= form_with url: opinion_question_fact_responses_path(@opinion_question), class: "answer-form" do |form| %>
          <%= hidden_field_tag :fact_question_id, @fact_question.id %>
          <fieldset>
            <legend class="sr-only">Choose one answer</legend>
            <% @answer_choices.each_with_index do |(option, original_index), display_index| %>
              <label class="answer-option ui-choice">
                <%= radio_button_tag :selected_option, original_index, false, required: true %>
                <span class="answer-letter"><%= ("A".ord + display_index).chr %></span>
                <span><%= glossary_text(option) %></span>
              </label>
            <% end %>
          </fieldset>
          <footer class="quiz-action-footer ui-action-footer">
            <%= form.submit "Check my answer", class: "button button-primary button-wide" %>
          </footer>
        <% end %>
        <p class="quiz-hint">You’ll see the correct answer, an explanation and its source next.</p>
      </article>
    <% end %>

    <aside class="opinion-reminder">
      <span>Your opinion</span>
      <strong><%= @user_opinion.label %></strong>
      <%= link_to "Revise", opinion_question_path(@opinion_question) %>
    </aside>
  </div>
</section>
