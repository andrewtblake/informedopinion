<% content_for :title, "My opinions — Informed Opinion" %>

<section class="editorial-home opinions-page ui-page">
  <div class="container">
    <header class="editorial-masthead opinions-masthead ui-masthead">
      <p class="editorial-kicker"><%= site_copy(:opinions_kicker) %></p>
      <h1><%= site_copy(:opinions_heading) %></h1>
      <p><%= site_copy(:opinions_intro) %></p>
    </header>

    <%= form_with url: stats_path, method: :get, class: "opinions-tools", role: "search" do |form| %>
      <div class="opinion-search-field">
        <%= form.label :q, "Search your opinions", class: "sr-only" %>
        <%= form.search_field :q,
          value: @query,
          placeholder: "Search your opinions",
          autocomplete: "off" %>
        <button type="submit" class="opinion-search-button" aria-label="Search">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="10.5" cy="10.5" r="6.5"></circle>
            <path d="m15.5 15.5 5 5"></path>
          </svg>
        </button>
      </div>
      <div class="opinion-order-field">
        <%= form.label :sort, "Order by" %>
        <%= form.select :sort,
          options_for_select(@sort_options.map { |value, label| [ label, value ] }, @sort),
          {},
          data: { controller: "autosubmit", action: "change->autosubmit#submit" } %>
      </div>
    <% end %>

    <header class="opinions-index-heading">
      <p><%= pluralize(@result_count, "opinion") %></p>
      <% if @query.present? %>
        <%= link_to "Clear search", stats_path(sort: @sort), class: "editorial-clear" %>
      <% end %>
    </header>

    <div class="opinions-grid">
      <% @opinion_records.each do |record| %>
        <% question = record[:question] %>
        <% opinion = record[:opinion] %>
        <% progress = record[:progress] %>
        <% arrow_x, arrow_y = opinion_arrow_endpoint(opinion, progress.weight) %>

        <article class="opinion-card">
          <div class="opinion-card-taxonomy">
            <% if question.category %>
              <span><%= question.category.name %></span>
            <% end %>
            <% question.tags.first(2).each do |tag| %>
              <span><%= tag.name %></span>
            <% end %>
          </div>

          <div class="opinion-card-body">
            <div class="opinion-card-copy">
              <h2><%= link_to question.title, opinion_question_path(question) %></h2>
              <p class="opinion-card-statement"><%= question.statement %></p>

              <p class="compact-opinion-heading">
                <span>Your position</span>
                <strong><%= opinion.label %></strong>
              </p>

              <p class="compact-result-numbers">
                <strong><%= whole_percentage(progress.weight) %>% weight</strong>
                <span><%= progress.correct %>/<%= progress.answered %> correct · <%= progress.remaining %> unseen</span>
              </p>

              <nav class="personal-card-actions" aria-label="<%= question.title %> actions">
                <%= link_to(
                  progress.complete? ? "Review quiz" : progress.answered.positive? ? "Resume quiz" : "Start quiz",
                  opinion_question_quiz_path(question)
                ) %>
                <%= link_to "Revise opinion", opinion_question_path(question) %>
              </nav>
            </div>

            <svg
              class="personal-choice-dial compact-choice-dial"
              viewBox="0 0 400 225"
              role="img"
              aria-label="Your opinion: <%= opinion.label %>; weight <%= whole_percentage(progress.weight) %>%"
            >
              <title><%= opinion.label %>: <%= whole_percentage(progress.weight) %>% weight</title>
              <defs>
                <marker id="arrowhead-<%= question.id %>" markerWidth="8" markerHeight="8" refX="5" refY="3" orient="auto">
                  <path d="M0,0 L0,6 L6,3 z" class="personal-arrow-head"></path>
                </marker>
                <% unless current_site.alternative? %>
                  <linearGradient id="opinion-arc-<%= question.id %>" x1="0%" y1="0%" x2="100%" y2="0%">
                    <stop offset="0%" class="personal-dial-stop-no"></stop>
                    <stop offset="50%" class="personal-dial-stop-neutral"></stop>
                    <stop offset="100%" class="personal-dial-stop-yes"></stop>
                  </linearGradient>
                <% end %>
              </defs>

              <% if current_site.alternative? %>
                <% [
                  [ 35, 25, 167, 158 ],
                  [ 70, 50, 134, 146 ],
                  [ 105, 75, 101, 134 ]
                ].each do |radius, percentage, label_x, label_y| %>
                  <path
                    d="M<%= 200 - radius %> 170 A<%= radius %> <%= radius %> 0 0 1 <%= 200 + radius %> 170"
                    class="personal-weight-guide"
                  ></path>
                  <text x="<%= label_x %>" y="<%= label_y %>" class="personal-weight-guide-label"><%= percentage %>%</text>
                <% end %>
              <% end %>

              <path
                d="M55 170 A145 145 0 0 1 345 170"
                class="personal-dial-arc"
                <% unless current_site.alternative? %>style="stroke: url(#opinion-arc-<%= question.id %>)"<% end %>
              ></path>

              <% if progress.weight.positive? %>
                <line
                  x1="200"
                  y1="170"
                  x2="<%= arrow_x %>"
                  y2="<%= arrow_y %>"
                  class="personal-weight-arrow"
                  marker-end="url(#arrowhead-<%= question.id %>)"
                ></line>
              <% end %>
              <% if current_site.alternative? %>
                <circle cx="200" cy="170" r="7" class="personal-dial-hub"></circle>
                <circle cx="200" cy="170" r="2.5" class="personal-dial-hub-centre"></circle>
              <% end %>
            </svg>
          </div>
        </article>
      <% end %>
    </div>

    <% if @opinion_records.empty? %>
      <div class="editorial-empty opinions-empty">
        <% if @query.present? %>
          <h2>No matching opinions</h2>
          <p>Try a broader search or <%= link_to "clear the search", stats_path(sort: @sort) %>.</p>
        <% else %>
          <h2>No opinions registered</h2>
          <p><%= link_to "Browse opinion questions", root_path %> to register your first position.</p>
        <% end %>
      </div>
    <% end %>

    <% if @total_pages > 1 %>
      <nav class="editorial-pagination" aria-label="Personal opinion pages">
        <% filters = { q: @query.presence, sort: @sort }.compact %>
        <% if @page > 1 %>
          <%= link_to "Previous", stats_path(filters.merge(page: @page - 1)) %>
        <% else %>
          <span>Previous</span>
        <% end %>
        <b>Page <%= @page %> of <%= @total_pages %></b>
        <% if @page < @total_pages %>
          <%= link_to "Next", stats_path(filters.merge(page: @page + 1)) %>
        <% else %>
          <span>Next</span>
        <% end %>
      </nav>
    <% end %>
  </div>
</section>
