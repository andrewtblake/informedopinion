<% content_for :title, "My stats — Informed Opinion" %>

<section class="topics-section stats-section">
  <div class="container">
    <h1 class="sr-only">My stats</h1>

    <div class="stats-topic-grid">
      <% @opinion_questions.each do |question| %>
        <% opinion = @opinions[question.id] %>
        <% progress = @progress_by_question.fetch(question) %>
        <% arrow_x, arrow_y = opinion ? opinion_arrow_endpoint(opinion, progress.weight) : StatsHelper::DIAL_CENTER %>

        <article class="topic-card personal-topic-card topic-<%= question.accent %>">
          <div class="topic-card-top">
            <%= link_to "Examine →", opinion_question_path(question), class: "topic-examine" %>
          </div>
          <h2 class="topic-headline"><%= question.title %></h2>
          <p class="topic-statement"><%= question.statement %></p>

          <div class="collective-summary collective-summary-primary personal-opinion-summary">
            <div class="collective-heading">
              <span>Your weighted opinion</span>
              <strong><%= opinion ? opinion.label : "Not registered yet" %></strong>
            </div>

            <svg
              class="personal-choice-dial"
              viewBox="0 0 400 225"
              role="img"
              aria-label="<%= opinion ? "Your opinion: #{opinion.label}; weight #{progress.weight}%" : "No opinion registered; weight 0%" %>"
            >
              <defs>
                <marker id="arrowhead-<%= question.id %>" markerWidth="8" markerHeight="8" refX="5" refY="3" orient="auto">
                  <path d="M0,0 L0,6 L6,3 z" class="personal-arrow-head"></path>
                </marker>
              </defs>

              <path d="M55 170 A145 145 0 0 1 345 170" class="personal-dial-arc"></path>

              <% label_positions = [
                [ 300, 165, 95, 42, "right" ],
                [ 282, 67, 110, 44, "center" ],
                [ 145, 4, 110, 44, "center" ],
                [ 8, 67, 110, 44, "center" ],
                [ 5, 165, 95, 42, "left" ]
              ] %>
              <% question.response_options.each_with_index do |label, position| %>
                <% x, y, width, height, alignment = label_positions[position] %>
                <foreignObject x="<%= x %>" y="<%= y %>" width="<%= width %>" height="<%= height %>">
                  <div class="personal-dial-choice personal-dial-choice-<%= alignment %> <%= "is-selected" if opinion&.position == position %>">
                    <%= label %>
                  </div>
                </foreignObject>
              <% end %>

              <% if opinion && progress.weight.positive? %>
                <line
                  x1="200"
                  y1="170"
                  x2="<%= arrow_x %>"
                  y2="<%= arrow_y %>"
                  class="personal-weight-arrow"
                  marker-end="url(#arrowhead-<%= question.id %>)"
                ></line>
              <% end %>
              <circle cx="200" cy="170" r="8" class="personal-dial-hub"></circle>
              <circle cx="200" cy="170" r="3" class="personal-dial-hub-centre"></circle>
            </svg>

            <p class="personal-result-numbers">
              <strong><%= number_with_precision(progress.weight, precision: 1, strip_insignificant_zeros: true) %>% weight</strong>
              <span><%= progress.correct %> correct · <%= progress.answered %> answered · <%= progress.remaining %> unseen</span>
            </p>
          </div>

          <div class="personal-card-actions">
            <% if opinion %>
              <%= button_to(
                progress.complete? ? "Review quiz" : progress.answered.positive? ? "Resume quiz" : "Start quiz",
                opinion_question_quiz_path(question),
                method: :get,
                class: "button stats-card-button"
              ) %>
              <%= button_to "Revise opinion",
                opinion_question_path(question),
                method: :get,
                class: "button stats-card-button" %>
            <% else %>
              <%= button_to "Register your opinion",
                opinion_question_path(question),
                method: :get,
                class: "button stats-card-button stats-card-button-wide",
                form_class: "stats-card-action-wide" %>
            <% end %>
          </div>
        </article>
      <% end %>
    </div>
  </div>
</section>
