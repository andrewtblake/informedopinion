<% content_for :title, "Check your email — #{current_site.name}" %>

<section class="account-page ui-page">
  <div class="container account-container account-container-narrow">
    <header class="account-masthead ui-masthead">
      <p class="editorial-kicker">Almost there</p>
      <h1>Check your email</h1>
      <p>Use the verification link we sent to finish creating your account.</p>
    </header>

    <div class="account-form-panel confirmation-waiting"
      data-controller="confirmation-status"
      data-confirmation-status-url-value="<%= user_confirmation_status_path %>">
      <div data-confirmation-status-target="waiting">
        <h2>Waiting for verification</h2>
        <p>You can leave this page open. Once you use the link in the same browser, this page will continue automatically.</p>
        <p>The message may take a minute to arrive. Check your spam folder if you cannot see it.</p>
      </div>
      <div data-confirmation-status-target="confirmed" tabindex="-1" hidden>
        <h2>Email verified</h2>
        <p>Your email was verified in another browser or device. You can now sign in here.</p>
        <%= link_to "Continue to sign in", new_user_session_path, class: "button button-primary" %>
      </div>

      <details class="ui-disclosure confirmation-resend">
        <summary>Didn’t receive the email?</summary>
        <%= form_with url: user_confirmation_path, method: :post, class: "account-form" do |form| %>
          <div class="field">
            <%= form.label :email, "Email address" %>
            <%= form.email_field :email, name: "user[email]", autocomplete: "email", required: true %>
          </div>
          <%= form.submit "Send another verification email", class: "button button-primary" %>
        <% end %>
      </details>
    </div>
  </div>
</section>
